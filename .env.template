# Template for local `docker compose` use only.
# On Coolify these same keys go into the service's "Environment Variables" tab; Coolify
# does not read this file. See COOLIFY.md.

# --- Required on first boot ---
# Admin console account. ADMINPASSWORD is only needed until the server has started once,
# because the ini is created then. Remove it afterwards: the entrypoint passes it as a
# command line argument and it ends up in clear text in the container logs.
ADMINUSERNAME=admin
ADMINPASSWORD=ChangeMePlease

# Name of the server data set. Do not use spaces or special characters.
# Changing it later starts a fresh world; the old data stays on disk under the old name.
SERVERNAME=zomboid

# --- playit.gg ---
# Paste the two public ports that playit.gg assigns to a "Project Zomboid" tunnel here.
# They are sequential, e.g. 10233 and 10234. The server has to listen on exactly these
# numbers, so changing the tunnel means changing these two values and redeploying.
PZ_PORT=16261
PZ_UDPPORT=16262

# --- Gameplay ---
# Seeds <SERVERNAME>_SandboxVars.lua on first boot: Apocalypse, Beginner, Builder,
# FirstWeek, SixMonthsLater, Survival, Survivor.
SERVERPRESET=Apocalypse

# --- Identity / visibility ---
# false is recommended behind playit.gg: the Steam browser cannot advertise the tunnel.
PUBLIC=false
DISPLAYNAME=Zomboid
# Join password, optional.
SERVER_PASSWORD=
# Runs the server without Steam integration. Only needed for non-Steam clients.
NOSTEAM=false
# true = leave Mods=/WorkshopItems= in the ini alone (edit them by hand).
SELF_MANAGED_MODS=false

# --- Resources ---
# JVM heap. 2048m is tight for Build 42; 4G is a sane default.
MEMORY=4G

# --- Storage ---
# In Coolify use absolute paths so data survives redeploys.
PZ_DATA_PATH=./data
PZ_WORKSHOP_PATH=./workshop-mods

# --- Optional, documented in README.MD ---
#MIN_MEMORY=2048m
#MAX_MEMORY=4096m
#RCONPASSWORD=
#MOD_IDS=
#WORKSHOP_IDS=
#COOP=False
#DEBUG=False
#FORCEUPDATE=False
#FORCESTEAMCLIENTSOUPDATE=False
